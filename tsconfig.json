{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules"],
  "include": [".plasmo/index.d.ts", "./**/*.ts", "./**/*.tsx"],
  "compilerOptions": {
    "paths": {
      "~lib/*": ["./src/lib/*"],
      "~types": ["./src/types/index.ts"],
      "~constants": ["./src/constants/index.ts"],
      "~components/*": ["./src/components/*"]
    },
    "baseUrl": "."
  }
}
